{
  "name": "aifanyi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "pnpm build:chrome && pnpm build:edge && pnpm build:firefox && pnpm build:demo",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:edge": "wxt build -b edge --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:demo": "vite build --config vite.demo.config.ts",
    "zip": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@simonwep/pickr": "^1.10.2",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "@wxt-dev/module-vue": "1.0.3",
    "happy-dom": "20.14.3",
    "typescript": "5.9.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11",
    "wxt": "0.21.4"
  }
}
